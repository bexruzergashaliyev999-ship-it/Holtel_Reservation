def get_rooms(room_type):

    if room_type == "Standard":
        return hotel.standart

    elif room_type == "Comfort":
        return hotel.comfort

    elif room_type == "Deluxe":
        return hotel.deluxe

    elif room_type == "Premium":
        return hotel.premium

    elif room_type == "Luxury":
        return hotel.luxury

    elif room_type == "VIP":
        return hotel.vip

