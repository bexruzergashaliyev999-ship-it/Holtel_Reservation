            )

            bor = True

    if not bor:
        print(" - Bron qilingan xona yoq")

    print("\n--- BOSH XONALAR ---")

    bor = False

    for xona, data in rooms.items():

        if xona not in booked_rooms:

            print(
                f"Xona {xona} | "
                f"Narxi: ${data[1]}"
            )

            bor = True

    if not bor:
        print(" - uzur bosh xona yoq")

def book_room():

    print("\n------------------------------------")
    print("          XONA BRON QILISH")
    print("--------------------------------------")

    print("1. Standard")
    print("2. Comfort")
    print("3. Deluxe")
    print("4. Premium")
    print("5. Luxury")
    print("6. VIP")

    choice = input("\n - Xona turini tanla: ")

    room_types = {
        "1": "Standard",
        "2": "Comfort",
        "3": "Deluxe",
        "4": "Premium",
        "5": "Luxury",
        "6": "VIP"
    }

    if choice not in room_types:
        print(" - uzur bunday tanlov yoq")
        return

    room_type = room_types[choice]

    rooms = get_rooms(room_type)

    room = hotel.room_features[room_type]

    print("\n-----------------------------------")
    print(f"          {room_type.upper()}")
    print("-------------------------------------")

    print(room["description"])

    print("\nQulayliklar:")

    for qulaylik in room["qulayliklar"]:
        print(f"- {qulaylik}")

    print("\n--- XONALAR ---")

    for xona, data in rooms.items():

        if xona in booked_rooms:

            bron = booked_rooms[xona]

            print(
                f"Xona {xona} | "
                f"BAND | "
                f"{bron[1]} - {bron[2]}"
            )

        else:

            print(
                f"Xona {xona} | "
                f"BOSH | "
                f"${data[1]}"
            )

    xona = input("\nXona raqamini tanlang: ")

    try:
        xona = int(xona)

    except ValueError:
        print(" - Xona raqamini to'g'ri kiriting")
        return

    if xona not in rooms:
        print(" - Bunday xona mavjud emas")
        return

    

    ism_familya = input(
        "iltimos ism va familyangizni kriting:   "
    )

    kunlar = int(input(
        "nech kun qolmoqchisiz: "
    ))

    kirish = input(
        "\nKirish sanasi (yil.oy.kum): "
    )

    chiqish = input(
        "Chiqish sanasi (yil.oy.kum): "
    )



    if xona in booked_rooms:

        bron = booked_rooms[xona]

        print("\nXONA BAND!")

        print(
            f"Xona {xona} "
            f"{bron[1]} - {bron[2]} "
            f"oralig'ida band."
        )

        return

    narx = rooms[xona][1]
    total = narx * kunlar

    booked_rooms[xona] = (
        room_type,
        kirish,
        chiqish
    )

    


    print("\n-----------------------------------")
    print("  --- Bron qilish muvaffaqiyatli amalga oshirildi ---")
    print("-------------------------------------")

    print(f"Mijoz: {ism_familya} ")
    print(f"Xona: {xona}")
    print(f"Xona Turi: {room_type}")
    print(f"Narxi: ${narx}/day")
    print(f"kunlar: {kunlar} kun")
    print(f"Kirish: {kirish}")
    print(f"Chiqish: {chiqish}")
    print("-----------------------")
    print(f" --  Umumiy narx: ${total}")
    print("-----------------------")

    



