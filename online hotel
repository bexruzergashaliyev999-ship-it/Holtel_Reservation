def show_rooms():
    print("\n===================================")
    print("  -- Choose Room Type -- ")
    print("===================================")

    print("1. Standard")
    print("2. Comfort")
    print("3. Deluxe")
    print("4. Premium")
    print("5. Luxury")
    print("6. VIP")

    choice = input("\n - Dear customer, please choose: ")

    room_types = {
        "1": "Standard",
        "2": "Comfort",
        "3": "Deluxe",
        "4": "Premium",
        "5": "Luxury",
        "6": "VIP",
    }

    if choice not in room_types:
        print(" - Sorry, no such choice available.")
        return

    room_type = room_types[choice]
    rooms = get_rooms(room_type)

    print("\n===================================")
    print(f"       {room_type.upper()} ROOMS")
    print("===================================")

    print("\n--- Booked Rooms ---")
    bor = False

    for xona in rooms:
        if xona in booked_rooms:
            data = booked_rooms[xona]
            print(f"Room {xona}: {data[1]} - {data[2]}")
            bor = True

    if not bor:
        print(" - No booked rooms.")

    print("\n--- AVAILABLE ROOMS ---")
    bor = False

    for xona, data in rooms.items():
        if xona not in booked_rooms:
            print(f"Room {xona} | Price: ${data[1]}")
            bor = True

    if not bor:
        print(" - Sorry, no available rooms.")


def book_room():
    print("\n------------------------------------")
    print("         ROOM RESERVATION")
    print("--------------------------------------")

    print("1. Standard")
    print("2. Comfort")
    print("3. Deluxe")
    print("4. Premium")
    print("5. Luxury")
    print("6. VIP")

    choice = input("\n - Choose room type: ")

    room_types = {
        "1": "Standard",
        "2": "Comfort",
        "3": "Deluxe",
        "4": "Premium",
        "5": "Luxury",
        "6": "VIP",
    }

    if choice not in room_types:
        print(" - Sorry, no such choice available.")
        return

    room_type = room_types[choice]
    rooms = get_rooms(room_type)
    room = hotel.room_features[room_type]

    print("\n-----------------------------------")
    print(f"         {room_type.upper()}")
    print("-------------------------------------")

    print(room["description"])

    print("\nAmenities:")
    for qulaylik in room["qulayliklar"]:
        print(f"- {qulaylik}")

    print("\n--- ROOMS ---")

    for xona, data in rooms.items():
        if xona in booked_rooms:
            bron = booked_rooms[xona]
            print(f"Room {xona} | BOOKED | {bron[1]} - {bron[2]}")
        else:
            print(f"Room {xona} | AVAILABLE | ${data[1]}")

    xona = input("\nChoose room number: ")

    try:
        xona = int(xona)
    except ValueError:
        print(" - Please enter a valid room number.")
        return

    if xona not in rooms:
        print(" - Such room does not exist.")
        return

    ism_familya = input("Please enter your first and last name:    ")
    kunlar = int(input("How many days would you like to stay: "))
    kirish = input("\nCheck-in date (YYYY.MM.DD): ")
    chiqish = input("Check-out date (YYYY.MM.DD): ")

    if xona in booked_rooms:
        bron = booked_rooms[xona]
        print("\nROOM IS BOOKED!")
        print(f"Room {xona} is booked between {bron[1]} - {bron[2]}.")
        return

    narx = rooms[xona][1]
    total = narx * kunlar

    booked_rooms[xona] = (room_type, kirish, chiqish)

    print("\n-----------------------------------")
    print("   --- Reservation Successful ---")
    print("-------------------------------------")

    print(f"Customer: {ism_familya}")
    print(f"Room: {xona}")
    print(f"Room Type: {room_type}")
    print(f"Price: ${narx}/day")
    print(f"Days: {kunlar} days")
    print(f"Check-in: {kirish}")
    print(f"Check-out: {chiqish}")
    print("-----------------------")
    print(f" -- Total Price: ${total}")
    print("-----------------------")


def show_booked_rooms():
    print("\n --------------------------------")
    print(" -- Booked Rooms -- ")
    print("----------------------------------")

    if len(booked_rooms) == 0:
        print(" - No booked rooms right now.")
        return

    for xona, data in booked_rooms.items():
        print(f"Room {xona} | {data[0]} | {data[1]} - {data[2]}")


while True:
    print("\n")
    print("--------------------------")
    print(" -- Hotel Reservation -- ")
    print("--------------------------")

    print("1. Room Information")
    print("2. View Rooms")
    print("3. Book Room")
    print("4. Booked Rooms")
    print("5. Exit")

    choice = input(" - Dear customer, please choose: ")

    if choice == "1":
        room_information()

    elif choice == "2":
        show_rooms()

    elif choice == "3":
        book_room()

    elif choice == "4":
        show_booked_rooms()

    elif choice == "5":
        print("\n -- Thank you, dear customer -- ")
        print("- Hotel Reservation program ended -")
        break

    else:
        print("\n - Sorry, no such choice available.")
